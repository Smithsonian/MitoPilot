plugins {
	id 'nf-sqldb@0.5.0'
}

executor {
    queueSize = 50
    pollInterval = '30 sec'
    submitRateLimit = '10/1min'
}

singularity {
  enabled = true
  pullTimeout = '60 min'  // large image on Hydra's shared filesystem can exceed the 20 min default
  runOptions = '-B /scratch02/'
}

process {
  executor = 'sge'
  container = '<<CONTAINER_ID>>'
  penv = 'mthread'
  // check if "himem" is needed (requesting more than 8 Gb RAM per CPU)
  clusterOptions = {
    if (((opts.memory * task.attempt) / opts.cpus) > 8) {
      "-l mres=${opts.memory * task.attempt}G,h_data=${(opts.memory * task.attempt) / opts.cpus}G,h_vmem=${(opts.memory * task.attempt) / opts.cpus}G,himem -S /bin/bash"
    } else {
      "-l mres=${opts.memory * task.attempt}G,h_data=${(opts.memory * task.attempt) / opts.cpus}G,h_vmem=${(opts.memory * task.attempt) / opts.cpus}G -S /bin/bash"
    }
  }
  cpus = { opts.cpus } // set number of CPUs based on value pulled from SQL database
}

// SQL database configuration (https://github.com/nextflow-io/nf-sqldb)
sql {
  db {
    sqlite {
      url = 'jdbc:sqlite:.sqlite?journal_mode=WAL&busy_timeout=5000'
    }
  }
}

// Pipeline parameters
params {
    rawDir = '<<RAW_DIR>>'                  // Directory containing raw data
    asmbDir = '<<ASMB_DIR>>'                // Directory containing user-supplied mitogenomes
    publishDir = 'out'                      // Directory to publish pipeline outputs
    minDepth = <<MIN_DEPTH>>                // Skip samples with less than this read depth
    ncbi_api_key = '<<NCBI_API_KEY>>'       // Optional NCBI API key for BLAST + GenBank fetch (https://www.ncbi.nlm.nih.gov/datasets/docs/v2/api/api-keys/)
    mitos_condaenv = 'mitos'
    trnaScan_condaenv = 'trnascan-se'
    aragorn_condaenv = 'aragorn'
    orffinder_condaenv = 'orffinder'
    preprocess {
        container = process.container
        executor = process.executor
    }
    assemble {
        maxRetries = 1
        container = process.container
        executor = process.executor
    }
    coverage {
        cpus = 4
        clusterOptions = "-l mres=64G,h_data=16G,h_vmem=16G,himem -S /bin/bash"
        container = process.container
        executor = process.executor
    }
    scaffold_join {
        cpus = 1
        clusterOptions = "-l mres=32G,h_data=32G,h_vmem=32G,himem -S /bin/bash"
        container = process.container
        executor = process.executor
    }
    annotate {
        container = process.container
        executor = process.executor
    }
    curate {
        container = process.container
        executor = process.executor
    }
    orf {
        container = process.container
        executor = process.executor
    }
    validate {
        container = process.container
        executor = process.executor
    }
    blast_ref_align {
        cpus = 1
        clusterOptions = "-l mres=32G,h_data=32G,h_vmem=32G,himem -S /bin/bash"
        container = process.container
        executor = process.executor
    }
    blast_gb {
        cpus = 4                            // -num_threads for the local BLAST search
        maxForks = 10 // only allow 10 concurrent BLAST runs to avoid server timeout issues
        maxRetries = 3
        // Memory is requested through clusterOptions on Hydra, not the memory
        // directive (mres = total, h_data/h_vmem = per CPU). Measured peak RSS is
        // 672 MiB, but h_vmem caps ADDRESS SPACE and blastn memory-maps the whole
        // database volume, so this is sized well above the RSS: 4G per CPU x 4
        // CPUs. Still under the 8G-per-CPU himem threshold above.
        clusterOptions = "-l mres=16G,h_data=4G,h_vmem=4G -S /bin/bash"
        // The reference fetch/stamp steps share this params block but run at 1 CPU
        // (HTTP and file copying), so they take a much smaller reservation instead
        // of the search's.
        // The fetch/stamp steps are one single-threaded Rscript doing HTTP; peak
        // RSS is ~70 MB. 2G is ample now that the module sets OMP_NUM_THREADS=1
        // (without it R reserved GBs of address space and h_vmem killed the task
        // regardless of the cap).
        ref_fetch_clusterOptions = "-l mres=2G,h_data=2G,h_vmem=2G -S /bin/bash"
        db_dir = '/ref_dbs/mito_metazoa'    // local BLAST database, baked into the container
        db_name = 'mito_metazoa'
        container = process.container
        executor = process.executor
    }
}

// pipeline will exit with a non-zero exit code if any failed tasks are ignored using the ignore error strategy
workflow {
  failOnIgnore = true
}
